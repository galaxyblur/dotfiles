[user]
	name = Corky Brown
	email = galaxyblur@gmail.com
[color]
	diff = auto
	status = auto
	branch = auto
	interactive = auto
[alias]
	st = status
	ci = commit
	co = checkout
	lg = log --graph --pretty=format:'%Cgreen%>(12,trunc)%cr%Creset %C(bold blue)%>(15,trunc)%an%Creset %Cred%h%Creset%C(yellow)%d%Creset %s' --abbrev-commit --date=relative
[core]
	editor = nvim
	excludesfile = ~/.gitignore
[push]
	default = current
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[diff]
  external = difft
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  difftool = true

# Machine-local, unmanaged. Keep last so it wins.
[include]
  path = .gitconfig.local
